# ─── Supabase ─────────────────────────────────────────────────────────────────
# Your Supabase project URL (found in: Supabase dashboard → Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous key (public — safe to expose in client)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─── Mapbox ───────────────────────────────────────────────────────────────────
# Used for Quest & Hunt map features (Build 4+)
# Get yours at: https://account.mapbox.com/access-tokens/
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-token-here

# ─── AI (server-side only) ────────────────────────────────────────────────────
# NEVER expose AI keys in EXPO_PUBLIC_ variables — they would be bundled into
# the client. Set these in the API server's environment instead.
#
# OpenAI / Anthropic / etc. — add to artifacts/api-server environment:
# OPENAI_API_KEY=sk-...

# ─── App ──────────────────────────────────────────────────────────────────────
# Set automatically by the Replit workflow — do not set manually
# EXPO_PUBLIC_DOMAIN=your-repl.replit.dev
