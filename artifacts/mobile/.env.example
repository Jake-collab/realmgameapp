# ──────────────────────────────────────────────────────────────────────────────
# Worlds — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing real secrets.
#
# See docs/SUPABASE_SETUP.md for step-by-step configuration instructions.
# ──────────────────────────────────────────────────────────────────────────────

# ── Supabase (required for authentication and database features) ────────────────
# Find these in your Supabase project: Settings → API

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY. NEVER set this in the mobile app.
# Used exclusively by the API server (artifacts/api-server).
# If you accidentally set this in the mobile app, rotate it immediately.
# SUPABASE_SERVICE_ROLE_KEY= (server-only; configure in artifacts/api-server)

# ── Mapbox (required for Quest Map and Hunt Map — Build 5) ──────────────────────
# https://account.mapbox.com/access-tokens/
# Public token only in mobile — no secret key in client code.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── RevenueCat (public SDK keys; safe to bundle in the native app) ─────────────
EXPO_PUBLIC_REVENUECAT_TEST_API_KEY=
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=

# ── App configuration ──────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_VERSION=1.0.0

# Development domain (set automatically by Replit — do not edit manually)
EXPO_PUBLIC_DOMAIN=
REPLIT_DEV_DOMAIN=
REPL_ID=

# ── Optional native/deep-link configuration ───────────────────────────────────
# Keep the placeholder until the owner assigns a production domain.
EXPO_PUBLIC_PRODUCTION_DOMAIN=
