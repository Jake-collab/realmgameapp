# Server-only configuration. Keep real values in Replit Secrets or CI secrets.
NODE_ENV=development
PORT=3000
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional AI Quest generation. Generated content is always draft-only.
AI_PROVIDER=openai-compatible
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=

# Optional automated moderation. Manual-only is the safe default.
MODERATION_PROVIDER=manual
MODERATION_AUTOMATION_ENABLED=false
MODERATION_API_URL=https://api.openai.com/v1/moderations
MODERATION_API_KEY=
MODERATION_AUTO_APPROVAL_MODE=manual_only

# Optional Expo push delivery; native device builds are still required.
EXPO_ACCESS_TOKEN=

# Comma-separated exact browser origins. Empty means development-friendly CORS.
CORS_ORIGINS=

# Trusted scheduled-job worker. Keep disabled until the Supabase project is linked.
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_SECONDS=60
SCHEDULER_MAINTENANCE_INTERVAL_SECONDS=3600
MODERATION_MEDIA_RETENTION_DAYS=30